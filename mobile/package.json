{
  "name": "stringphone-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "^57.0.29",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.27",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "expo start",
    "dev:client": "expo start --dev-client",
    "build:android:local": "expo run:android",
    "build:ios:local": "expo run:ios",
    "build:android:dev": "npx eas-cli@24.13.0 build --platform android --profile development",
    "build:ios:dev": "npx eas-cli@24.13.0 build --platform ios --profile development",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:local-history": "node --import tsx ../scripts/verify-mobile-local-history.mjs",
    "check:api-config": "node --env-file-if-exists=.env.local scripts/check-api-config.mjs",
    "test:api-config": "node scripts/check-api-config.mjs --self-test",
    "lint": "npm run check:server-boundary && expo lint",
    "check:server-boundary": "node scripts/check-server-boundary.cjs"
  },
  "private": true
}
