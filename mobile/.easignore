# EAS uploads the git repository root for this nested application.
# Exclude local secrets, generated native projects, and build artifacts.
**/node_modules/**
**/.env*
**/.git/**
**/.expo/**
**/dist/**
**/.vercel/**
**/.npm-cache/**
**/credentials.json
**/*.jks
**/*.keystore
**/*.p12
**/*.p8
**/*.mobileprovision
**/*.key
**/*.pem
output/**
*.wav
*.mp3
mobile/android/**
mobile/ios/**
