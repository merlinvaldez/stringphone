{
  "cli": {
    "version": "24.13.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "node": "22.23.1",
      "env": {
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_API_URL_DEVELOPMENT": "https://stringphone-ag6qla52f-merlin-projects.vercel.app/api"
      },
      "android": {
        "image": "ubuntu-26.04-jdk-17-ndk-r27b-sdk-57",
        "buildType": "apk"
      },
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    }
  }
}
