{
  "expo": {
    "name": "StringPhone",
    "slug": "stringphone-mobile",
    "version": "1.0.6",
    "orientation": "default",
    "scheme": "stringphone",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-audio",
        {
            "microphonePermission": "Allow StringPhone to use the microphone for recorded and live translation.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "StringPhone does not access your camera.",
          "microphonePermission": "Allow StringPhone to use the microphone for recorded and live translation."
        }
      ],
      "expo-sqlite",
      "expo-asset"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ai.stringphone.mobile",
      "buildNumber": "7",
      "supportsTablet": true
    },
    "android": {
      "package": "ai.stringphone.mobile",
      "versionCode": 7,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {}
    }
  }
}
