{
  "expo": {
    "name": "StringPhone",
    "slug": "stringphone-mobile",
    "version": "1.0.4",
    "orientation": "default",
    "scheme": "stringphone",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow StringPhone to record your voice for transcription and translation.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sqlite",
      "expo-asset"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ai.stringphone.mobile",
      "buildNumber": "5",
      "supportsTablet": true
    },
    "android": {
      "package": "ai.stringphone.mobile",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cadb69a8-b3e2-4e2c-b6a2-8b3ce05475a7"
      }
    },
    "owner": "merlinvaldez"
  }
}
